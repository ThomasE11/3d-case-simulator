.vercel
node_modules
dist
*.log
*.log.gz

# Environment files — never commit real credentials
.env
.env.local
.env.*.local

.playwright-mcp
.claude/worktrees
.claude/launch.json

# Test artifacts & screenshots (but allow ECG images and clinical images)
!public/images/**
*.png
*.jpg
*.jpeg
!public/images/ecg/*.jpg
!public/images/ecg/*.png
!public/images/clinical/*.jpg
!public/images/clinical/*.png
!public/images/placeholders/*.jpg
!public/images/placeholders/*.png
!public/scene-assets/
!public/scene-assets/*.png
# baked skin maps (Phase A) — consumed by the Phase B SSS material
!public/models/patient-*-skin-*.png
# Kenney CC0 prop colormaps referenced by public/models/props/*.glb
!public/models/props/**/*.png
# Old agent framework + AI tooling caches
.gstack/
.bmad/
.ralph/

# Audit tooling artifacts — the scripts in scripts/ are checked in, but
# their timestamped JSON outputs are not.
test-results/
/probe-out/
/tmp/

# Obsolete report / summary / checklist stubs regenerated ad-hoc; keep
# the patterns so no-one recommits them.
*_REPORT.md
*_SUMMARY.md
*_CHECKLIST.md
TEST_PLAN.md

# iOS / Capacitor / build artifacts
build/
ios/
*.bak.glb
.DS_Store

# Codegraph
.codegraph/

# One-off Playwright probes dumped at the repo root during debugging.
# Real, reusable probes belong in scripts/ and are checked in there.
/probe-*.mjs
/record-*.mjs
/analyse_*.py
/scripts/_*.mjs
/scripts/_*.py
.env*.local

# recoverable temp probes (never committed)
scripts/.trash/
